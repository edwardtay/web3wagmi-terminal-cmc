# Copy to .env.local. Every value is read server-side and none reaches the
# browser: the CSP in next.config.ts allows the page to reach 'self' and the
# Binance WebSocket only, so a key cannot leak through a client fetch.
#
# Every panel degrades to an explained empty state when its key is absent. The
# app starts and runs without any of these; it just shows less.

# ---- CoinMarketCap ---------------------------------------------------------
#
# The only key the CMC panels need. Free tier is enough: every endpoint this
# app calls is available on Basic except the OHLCV history, which is not used.
#
# Get one at https://coinmarketcap.com/api
#
# Budgets are sized for the free Basic allowance of 15,000 credits a month:
#   scripts/cmc-sample.mjs   2 calls / 30 min   =  2,880
#   /api/forced              3 calls / 20 min   =  6,480
#   /api/leverage           10 calls / 2 h      =  3,600
#   /cmc                     1 call  / 1 h      =    720
#                                        total = 13,680
CMC_API_KEY=

# ---- The Graph Token API ---------------------------------------------------
#
# Powers the on-chain desks (exchange netflow, holder concentration). Not used
# by anything CoinMarketCap-related. From thegraph.market, not Subgraph Studio:
# a Studio gateway key answers 401 here.
GRAPH_TOKEN_API_KEY=

# Optional. Pin the Token API host. Leave unset in production: the client tries
# the canonical host and falls back on its own. Only set this if your network
# drops token-api.thegraph.com at the TLS handshake, which some do.
# GRAPH_TOKEN_API_BASE=https://token-api.service.pinax.network

# Optional. Subgraph gateway key, for the standardized-schema panel.
GRAPH_SUBGRAPH_KEY=

# ---- Ask, the in-terminal question box -------------------------------------
#
# Optional. Without these the Ask box is hidden and nothing else changes.
GROQ_API_KEY=
GROQ_MODEL=

# The fallback takes comma-separated keys and models, tried in order. Groq meters
# tokens per minute per model, so its other models on the same keys make a working
# fallback: https://api.groq.com/openai/v1 with openai/gpt-oss-20b,qwen/qwen3.8-27b.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=

# ---- Archive RPC -----------------------------------------------------------
#
# Optional. The exchange netflow desk reads historical balances. Without this
# it uses a pool of free public archive endpoints, which rate limit. Set it to
# a QuickNode or similar endpoint to replace the whole pool.
NETFLOW_RPC_ETH=
